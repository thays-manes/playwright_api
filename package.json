{
  "name": "api-playwright-jsonplaceholder",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados de API (JSONPlaceholder) com Playwright Test, TypeScript, Zod e Allure Report.",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "test": "npm run limpar && playwright test",
    "test:api": "npm run limpar && playwright test --project=api",
    "test:schemas": "npm run limpar && playwright test --project=schemas",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report playwright-report",
    "report:allure:generate": "allure generate allure-results --output allure-report",
    "report:allure:open": "allure open allure-report",
    "limpar": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "allure": "^3.0.0",
    "allure-playwright": "^3.3.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.0"
  }
}
